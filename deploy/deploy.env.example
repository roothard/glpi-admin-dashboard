# ==========================================================================
# deploy.env — infra-specific settings for the deploy scripts.
#
# Copy this file to deploy/deploy.env (git-ignored) and fill in the values
# for your servers. No passwords go here: authentication is by SSH key.
#
#   cp deploy/deploy.env.example deploy/deploy.env
#   $EDITOR deploy/deploy.env
# ==========================================================================

# --- SSH access to the web server ---------------------------------------
SSH_HOST="your-server-host-or-ip"
SSH_PORT="22"
SSH_LOGIN="deployuser"                 # login user (needs passwordless sudo)
SSH_KEY="$HOME/.ssh/your_deploy_key"

# --- Staging site (pda) --------------------------------------------------
PDA_USER="pda"                          # system user that owns the site
PDA_HOME="/home/pda"                    # install root (docroot is $PDA_HOME/public_html)
PDA_DEFAULT_BRANCH="main"               # branch deployed when none is given

# --- Production site (apps) ---------------------------------------------
APPS_USER="apps"
APPS_HOME="/home/apps"

# --- Behaviour -----------------------------------------------------------
KEEP_BACKUPS="10"                       # how many tar backups to keep per site
