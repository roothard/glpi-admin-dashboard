# ==========================================================================
# GLPI Projects Dashboard — configuration
# Copy this file to ".env" and fill in your values. NEVER commit your .env.
# Keep .env OUTSIDE the web docroot (this repo's docroot is /public).
# ==========================================================================

# --- GLPI connection (required) -------------------------------------------
# Base URL of your GLPI. Either the host or the full .../apirest.php URL works.
GLPI_URL=https://glpi.example.com

# API tokens. In GLPI: Setup > General > API — enable the REST API, create an
# API client to get the App-Token, and generate a personal "API token" on the
# user (Preferences > Remote access keys) for GLPI_USER_TOKEN.
GLPI_APP_TOKEN=your_app_token_here
GLPI_USER_TOKEN=your_user_token_here

# If your GLPI is behind Cloudflare (which strips the Authorization header),
# set this to true so the user token is also sent as a query parameter.
GLPI_TOKENS_IN_QUERY=false

# HTTP timeout in seconds.
GLPI_TIMEOUT=30

# Optional: if your API token's default profile lacks project/read rights,
# force an active profile (and optionally an entity) after login.
# GLPI_PROFILE_ID=4          # e.g. Super-Admin
# GLPI_ENTITY_ID=0           # root entity
# GLPI_ENTITY_RECURSIVE=true

# --- What to show ---------------------------------------------------------
# Only include projects of this GLPI "project type" (by name). Empty = all types.
PROJECT_TYPE=

# How to group projects into zones/columns on the board:
#   parent  -> group by the parent project's name (needs a parent; leaf-only)
#   entity  -> group by GLPI entity
#   type    -> group by project type
GROUP_BY=parent

# When GROUP_BY is entity/type, set true to only include projects that have a
# parent project. (Ignored for GROUP_BY=parent, which is always leaf-only.)
INCLUDE_ONLY_LEAF=false

# Optional literal prefix to strip from each zone label (e.g. "Portfolio · ").
AREA_STRIP_PREFIX=

# --- State name mapping ---------------------------------------------------
# Comma-separated keywords (case-insensitive substrings) that map a GLPI
# project-state NAME to a UI status. Works in any language — just list the
# words your states use.
STATE_INPROGRESS=proceso,progress,curso,doing,en cours
STATE_DONE=cerrado,closed,done,finished,terminé
STATE_PLANNED=espera,nuevo,new,planned,hold,waiting,à faire

# --- Output ---------------------------------------------------------------
# Where the generator writes the JSON the front-end reads.
OUTPUT=./public/data.json

# Timezone for the "generated at" stamp.
TIMEZONE=UTC
