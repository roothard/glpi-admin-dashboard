# ==========================================================================
# Optional environment overrides (Docker-friendly).
#
# The PRIMARY way to configure this app is the setup panel (/setup.php), which
# writes config/settings.json. These variables, if set, OVERRIDE that file —
# useful for containers/CI where you inject secrets as env vars.
#
# For the full list of settings, see config/settings.example.json and the panel.
# ==========================================================================

# GLPI connection
GLPI_URL=https://glpi.example.com
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=
GLPI_TOKENS_IN_QUERY=false

# Project selection
PROJECT_TYPE=

# Optional "Fichadas" (GPS check-ins) module — read-only GLPI DB
DB_HOST=
DB_NAME=
DB_USER=
DB_PASS=
