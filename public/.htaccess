# --- GLPI Projects Dashboard — basic hardening (Apache 2.4+) ---------------

# Never serve dotfiles (.env, .git, …) from the docroot.
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# Security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "no-referrer"
  # Self-contained page: allow only same-origin assets and inline styles/scripts.
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; base-uri 'self'; frame-ancestors 'self'"
</IfModule>

# Don't cache the data feed.
<IfModule mod_headers.c>
  <FilesMatch "data\.json$">
    Header set Cache-Control "no-store"
  </FilesMatch>
</IfModule>

Options -Indexes
